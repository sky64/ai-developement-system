#!/usr/bin/env bash
# Git credential helper for the agent identity (decision 0005).
#
# Only the "get" action is served, only for github.com. The username is
# aidev.bot.name and the token is produced by aidev.bot.tokenCommand, both
# from the user's git config (install-bot-identity.sh writes them), and only
# when the current repository has features.bot_identity on. The token is
# written to Git's stdin pipe at push time; it is never stored on disk or
# printed. "store" and "erase" are ignored.
# Tracing would print the token, so it is switched off before anything else.
{ set +x; } 2>/dev/null
set -euo pipefail
[ "${1:-}" = "get" ] || exit 0
host=""
while IFS= read -r line; do
  [ -z "$line" ] && break
  case "$line" in host=*) host="${line#host=}" ;; esac
done
[ "$host" = "github.com" ] || exit 0
tools="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
git rev-parse --git-dir >/dev/null 2>&1 || { echo "git-credential-op-bot: not inside a repository; the bot identity is enabled per repository" >&2; exit 1; }
if [ "$(python3 -I "$tools/aidev_config.py" get features.bot_identity 2>/dev/null)" != "true" ]; then
  echo "git-credential-op-bot: features.bot_identity is off in this repository's .claude/ai-dev-system.json" >&2; exit 1
fi
name="$(git config --get aidev.bot.name || true)"
cmd="$(git config --get aidev.bot.tokenCommand || true)"
[ -n "$name" ] || { echo "git-credential-op-bot: aidev.bot.name is not set; run tools/bot/install-bot-identity.sh" >&2; exit 1; }
[ -n "$cmd" ]  || { echo "git-credential-op-bot: aidev.bot.tokenCommand is not set; run tools/bot/install-bot-identity.sh" >&2; exit 1; }
if ! token="$(bash -c "$cmd" 2>/dev/null)" || [ -z "$token" ]; then
  echo "git-credential-op-bot: the token command produced nothing (secret manager locked or item missing)" >&2
  exit 1
fi
printf 'username=%s\npassword=%s\n' "$name" "$token"
