#!/usr/bin/env bash
# Git credential helper: the Solvela-bot GitHub token from 1Password.
#
# Only the "get" action is served, only for github.com. The token is read
# with `op read` at push time and written to Git's stdin pipe; it is never
# stored on disk or printed. "store" and "erase" are ignored.
# Tracing would print the token, so it is switched off before anything else.
{ set +x; } 2>/dev/null
set -euo pipefail
[ "${1:-}" = "get" ] || exit 0
host=""
while IFS= read -r line; do
  [ -z "$line" ] && break
  case "$line" in host=*) host="${line#host=}" ;; esac
done
[ "$host" = "github.com" ] || exit 0
if ! token="$(op read 'op://Agents/Solvela-bot GitHub token/credential' 2>/dev/null)" || [ -z "$token" ]; then
  echo "git-credential-op-bot: could not read the bot token from 1Password (locked or missing)" >&2
  exit 1
fi
printf 'username=Solvela-bot\npassword=%s\n' "$token"
